CREATE TABLE IF NOT EXISTS ex5_ti.funcionario-perfil-acesso(
    id  INTEGER GENERATED ALWAYS AS IDENTITY(
        START WITH 0
        INCREMENT BY 1
        MINVALUE 0
        MAXVALUE 100000000
        CACHE 1
        SEQUENCE NAME seq_funcionario_acesso_perfil_id
    ),
    perfil_acesso_id INTEGER NOT NULL,
    funcionario_id INTEGER NOT NULL,

    CONSTRAINT pk_funcionario-acesso-perfil_id PRIMARY KEY(id),

    CONSTRAINT uq_perfil-acesso_id UNIQUE(perfil_acesso_id),
    CONSTRAINT uq_funcionario_id UNIQUE(funcionario_id),

    CONSTRAINT fk_perfil-acesso_id FOREIGN KEY(perfil_acesso_id) REFERENCES ex5_ti.perfil_acesso(id),
    CONSTRAINT fk_funcionario_id FOREIGN KEY(funcionario_id) REFERENCES ex5_rh.funcionario(id)
)